# Root .gitignore for PokemonRedExperiments

# Training outputs (huge directories)
experiments/
Pipeline_V2/experiments/
Pipeline/experiments/

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db

# Large files
*.zip
*.tar.gz
*.7z
*.rar
!environment.yml

# Model files
*.pt
*.pth
*.pkl
*.h5
*.ckpt

# Videos
*.mp4
*.avi
*.gif

# Conda environments
poke_env/
poke_viz_extended/
venv/
env/

# Game files (copyrighted)
*.gb
*.gbc
*.state
*.sav
*.ram
!data/init.state
!data/has_pokedex.state
